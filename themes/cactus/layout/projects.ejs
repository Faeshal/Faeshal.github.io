<style>.project-title { font-size: 1.2em; } .project-title:before { content: none; }</style>
<article class="post" itemscope itemtype="http://schema.org/CollectionPage">
  <div class="content" itemprop="articleBody">
    <% if (page.current === 1) { %>
      <h1>Project History</h1>
      <p>Here's a list of projects I've worked on throughout my career as a Backend Engineer. Note that this list only includes office projects built with a private repository and a full development team ⛔ personal freelance projects are intentionally excluded, to keep this list focused and relevant.</p>
    <% } %>
    <% page.posts.forEach(function(project, i){ %>
      <h2 class="project-title"><%= (page.current - 1) * page.perPage + i + 1 %>. <%= project.title %></h2>
      <%- markdown(project.body) %>
    <% }); %>
  </div>
</article>
<%- partial('_partial/pagination') %>
